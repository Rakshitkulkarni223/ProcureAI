# MongoDB
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=procureai

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=8001
CORS_ORIGINS=http://localhost:3000

# Demo account (seeded on startup)
DEMO_EMAIL=demo@procureai.com
DEMO_PASSWORD=Demo@123
DEMO_NAME=Demo User

# AI Assistant (OpenAI-compatible). AI_PROVIDER is "gemini" or "groq" — the
# fallback always targets the other provider (so set both keys for a real
# cross-provider fallback). Leave AI_FALLBACK_MODEL blank to use the default
# for whichever provider isn't primary (openai/gpt-oss-120b for groq,
# gemini-3.1-flash for gemini) — set it only to override that default.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
AI_FALLBACK_MODEL=
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_MAX_TOKENS=2048

# Optional: live Google Shopping prices
SERPAPI_KEY=
